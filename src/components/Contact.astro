---
---
<section id="contact" aria-labelledby="contact-heading">
  <div class="relative flex h-[60vh] min-h-[380px] items-end justify-center overflow-hidden bg-black">
    <picture>
      <source srcset="/images/contact-bg.webp" type="image/webp" />
      <img
        src="/images/contact-bg.jpg"
        alt="Marble and walnut kitchen island designed by colorlab."
        loading="lazy"
        decoding="async"
        class="absolute inset-0 h-full w-full object-cover"
      />
    </picture>
    <h2
      id="contact-heading"
      class="relative z-10 mb-[24%] font-serif text-4xl text-white [text-shadow:0_2px_20px_rgba(0,0,0,0.85)] md:text-5xl"
    >
      Get in touch
    </h2>
  </div>

  <div class="bg-white px-6 py-16 text-center md:px-12">
    <div class="mx-auto max-w-xl space-y-6">
      <div>
        <p class="font-medium uppercase tracking-wide text-neutral-500">Location:</p>
        <p class="mt-1 text-lg">1411-A Dufferin St. - Toronto, Ontario, Canada</p>
      </div>
      <div>
        <p class="font-medium uppercase tracking-wide text-neutral-500">Office Hours:</p>
        <p class="mt-1 text-lg">Monday-Friday (By Appointment Only)</p>
      </div>
      <div class="pt-2">
        <a href="mailto:hello@colorlab.ca" class="text-lg underline underline-offset-4 hover:text-neutral-600">
          hello@colorlab.ca
        </a>
      </div>
      <div>
        <a href="tel:+14164509525" class="text-lg hover:text-neutral-600">+1 416 450 9525</a>
      </div>
    </div>
  </div>
</section>
