# colorlab. — example Nginx server block for static hosting
# Copy the relevant parts into your site's server block (e.g. /etc/nginx/sites-available/colorlab.ca)

server {
    listen 80;
    listen [::]:80;
    server_name colorlab.ca www.colorlab.ca;

    root /var/www/colorlab.ca/dist;
    index index.html;

    # ---- Compression ----
    gzip on;
    gzip_vary on;
    gzip_min_length 256;
    gzip_types text/plain text/css application/javascript application/json
               application/xml text/xml image/svg+xml font/woff2;

    # ---- Caching: fingerprint-free static assets get a long max-age ----
    location ~* \.(?:css|js|woff2|svg)$ {
        add_header Cache-Control "public, max-age=31536000, immutable";
        access_log off;
    }

    location ~* \.(?:jpg|jpeg|png|webp|ico)$ {
        add_header Cache-Control "public, max-age=31536000, immutable";
        access_log off;
    }

    # ---- HTML/XML/txt: always revalidate ----
    location ~* \.(?:html|xml|txt)$ {
        add_header Cache-Control "public, max-age=0, must-revalidate";
    }

    # ---- Basic security headers ----
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;

    location / {
        try_files $uri $uri/ /index.html;
    }
}
